TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Local fork: optional settings
# Drive a separate, signed-out Chrome started by scripts/start-chrome.sh instead of your main profile.
# BU_CDP_URL=http://127.0.0.1:9333
# BH_TELEMETRY=0
# Local text model via Ollama's OpenAI-compatible API (any non-empty key works):
# TEXT_MODEL_API_KEY=ollama
# TEXT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# TEXT_MODEL=gpt-oss:20b
# TEXT_MODEL_REASONING=low
# Hosts never sent to Jev or opened by it (comma-separated; subdomains included).
JEV_BLOCKED_HOSTS=
